<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="fill">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0f172a"
                android:centerColor="#1e3a8a"
                android:endColor="#2563eb"
                android:type="linear" />
        </shape>
    </item>
    <item android:width="180dp" android:height="180dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#22ffffff" />
            <stroke android:width="2dp" android:color="#60a5fa" />
        </shape>
    </item>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/ic_catalogo_custom" />
    </item>
</layer-list>
